{
    "name": "koobecaf/social-network",
    "description": "Nền tảng mạng xã hội PHP thuần theo kiến trúc MVC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^7.2"
    },
    "autoload": {
