APP_NAME=Koobecaf
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/koobecaf
APP_BASE_PATH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_PER_PAGE=10

# Khóa ký HMAC dùng để cấp token cho WebSocket (sinh ngẫu nhiên 64 ký tự hex).
# ĐỔI GIÁ TRỊ NÀY khi triển khai thật, và giữ kín (file .env đã nằm ngoài Git).
APP_KEY=

# ---------------- WebSocket (chat realtime) ----------------
# Bật/tắt tính năng chat realtime. Khi tắt, trang chat dùng AJAX polling.
WS_ENABLED=true
# Host mà WebSocket server lắng nghe.
WS_HOST=127.0.0.1
# Cổng của WebSocket server (chạy bằng `npm run ws`).
WS_PORT=8080
# Đường dẫn WebSocket endpoint.
WS_PATH=/ws
# Thời gian sống (giây) của token đăng nhập WebSocket.
WS_TOKEN_TTL=300
# Chu kỳ ping/pong để phát hiện kết nối chết (ms).
WS_HEARTBEAT_MS=30000
# Thời gian chờ client xác thực sau khi mở kết nối (ms) — socket treo sẽ bị đóng.
WS_AUTH_TIMEOUT_MS=10000
# Số tin nhắn tối đa gửi trong WS_RATE_WINDOW_MS mili giây (chống spam).
WS_RATE_LIMIT=20
WS_RATE_WINDOW_MS=10000
# Số kết nối tối đa trong pool MySQL của WebSocket server.
WS_DB_POOL=10

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koobecaf
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=koobecaf_session
SESSION_SECURE=false

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=no-reply@koobecaf.local
MAIL_FROM_NAME=Koobecaf
MAIL_DEBUG=false
